@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout
@rendermode InteractiveServer
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Entrar | FinanCore</PageTitle>

<div class="login-shell">
    <section class="login-panel" aria-labelledby="login-title">
        <div class="login-mark" aria-hidden="true">F</div>
        <p class="login-kicker">FinanCore</p>
        <h1 id="login-title">Bem-vindo de volta</h1>
        <p class="login-subtitle">Acesse sua gestão financeira com segurança.</p>

        <EditForm Model="form" OnValidSubmit="EntrarAsync" class="login-form">
            <DataAnnotationsValidator />

            <div class="field-group">
                <label for="email">E-mail</label>
                <InputText id="email" @bind-Value="form.Email" type="email" autocomplete="email" placeholder="voce@empresa.com" />
                <ValidationMessage For="@(() => form.Email)" />
            </div>

            <div class="field-group">
                <label for="senha">Senha</label>
                <InputText id="senha" @bind-Value="form.Senha" type="password" autocomplete="current-password" placeholder="Digite sua senha" />
                <ValidationMessage For="@(() => form.Senha)" />
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="login-error" role="alert">@errorMessage</div>
            }

            <button class="login-submit" type="button" @onclick="EntrarAsync" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="loading-indicator" aria-hidden="true"></span>
                    <span>Entrando...</span>
                }
                else
                {
                    <span>Entrar</span>
                    <span aria-hidden="true">&#8594;</span>
                }
            </button>
        </EditForm>

        <p class="login-footnote">Acesso protegido para sua empresa.</p>
    </section>
</div>

@code {
    private readonly LoginForm form = new();
    private bool isLoading;
    private string? errorMessage;

    private async Task EntrarAsync()
    {
        if (isLoading)
            return;

        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await Auth.LoginAsync(new LoginRequest(form.Email, form.Senha));
            if (result.Succeeded)
            {
                Navigation.NavigateTo("/");
                return;
            }

            errorMessage = result.ErrorMessage;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Não foi possível conectar ao sistema. Tente novamente em instantes.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class LoginForm
    {
        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe sua senha.")]
        public string Senha { get; set; } = string.Empty;
    }
}
